{
  "name": "@like12like12s/nuxt-base",
  "version": "0.5.4",
  "description": "Nuxt 4 base layer: Tailwind 4 preset + design tokens, core UI components, async/empty/error patterns, head/OG defaults, auth hook point. Extend it, never copy it.",
  "type": "module",
  "main": "./nuxt.config.ts",
  "private": true,
  "scripts": {
    "dev": "nuxt dev playground --port 3517",
    "build": "nuxt build playground",
    "prepare": "nuxt prepare playground",
    "typecheck": "nuxt typecheck playground",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:templates": "scripts/sync-templates.sh --check",
    "test": "npm run build && npm run test:unit && npm run test:e2e && npm run test:templates",
    "lint": "oxlint --deny-warnings kit/runtime kit/lib kit/bin",
    "gate": "npm run typecheck && npm run lint && npm test",
    "gate:ci": "node kit/runtime/project/gate-ci.mjs",
    "gate:kit": "node kit/tests/kit-gate.mjs"
  },
  "devDependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@nuxt/test-utils": "^4.4.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@playwright/test": "^1.65.1",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^21.0.4",
    "hono": "^4.13.18",
    "kysely": "^0.29.9",
    "mysql2": "^3.24.6",
    "nuxt": "^4.6.4",
    "oxlint": "^1.93.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "vue-tsc": "^3.2.0",
    "zod": "^4.6.7"
  },

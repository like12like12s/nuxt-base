# Template of /srv/{{kit.name}}/.env on the deploy host (chmod 600). Real values live only there — never commit them.
# Running tags — the deploy script rewrites these lines.
API_TAG=latest
UI_TAG=latest
# Host ports — must be registered and free.
API_PORT={{kit.apiPort}}
UI_PORT={{kit.uiPort}}
# Database (the API and the db-check step read it). SQLite lives in ./data on the host (bind mount).
DATABASE_URL={{kit.databaseUrlExample}}
# 1 = the db-check step applies pending migrations (after a backup) before the api container starts.
# Empty = check only: a deploy whose image is ahead of the database then fails and the API stays down until you migrate
# (`docker compose run --rm db-check node dist/db/cli.js migrate up`) or roll back.
DB_MIGRATE_ON_DEPLOY=1
# MySQL only: dump command run before a migration; without it the migration is refused (exit 3) unless
# DB_MIGRATE_NO_BACKUP=1 states that the backup is taken another way (e.g. your nightly backup job).
DB_BACKUP_CMD=
# App secrets below.

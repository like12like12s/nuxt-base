# Template of /srv/{{kit.name}}/.env on the deploy host (chmod 600). Real values live only there — never commit them.
# A second stage of this app on the same host (e.g. sit next to prod): its own directory, and here a different
# COMPOSE_PROJECT_NAME plus different host ports. Leave it unset for the only / the production stage.
#COMPOSE_PROJECT_NAME={{kit.name}}-sit
# Running tags — the deploy script rewrites these lines.
API_TAG=latest
UI_TAG=latest
# Host port of the UI — must be registered and free. The API has none: it is only reachable inside the compose
# network (docker-compose.yml says how to publish it on loopback if something outside compose needs it).
UI_PORT={{kit.uiPort}}
# Database (the API and the db-check step read it). SQLite lives in ./data on the host (bind mount).
DATABASE_URL={{kit.databaseUrlExample}}
# 1 = the db-check step applies pending migrations (after a backup) before the api container starts.
# Empty = check only: a deploy whose image is ahead of the database then fails and the API stays down until you migrate
# (`docker compose run --rm db-check node dist/db/cli.js migrate up`) or roll back.
DB_MIGRATE_ON_DEPLOY=1
# MySQL only: dump command run before a migration; without it the migration is refused (exit 3) unless
# DB_MIGRATE_NO_BACKUP=1 states that the backup is taken another way (e.g. your nightly backup job).
DB_BACKUP_CMD=
# App secrets below.
# @kit:if auth
# Auth: forward-auth headers are believed only with one of the first two (usage.md, "Auth"). Never set AUTH_DEV_MODE here.
AUTH_PROXY_SECRET=
AUTH_TRUSTED_PROXIES=
AUTH_ROLE_MAP=
# @kit:end
# @kit:if trace
# Tracing: empty = off. Inside the container 127.0.0.1 is the container itself — name the collector as the container sees it.
OTEL_EXPORTER_OTLP_ENDPOINT={{kit.otlpEndpoint}}
OTEL_SERVICE_NAME={{kit.name}}-api
# @kit:end
# @kit:if security
# Browser origins allowed to call the API directly (exact origins, no wildcard). Empty = same-origin only.
CORS_ORIGINS=
# @kit:end
# @kit:if notify
NOTIFIER_URL=
NOTIFIER_TOKEN=
# @kit:end

# Template of /srv/{{kit.name}}/.env on the deploy host (chmod 600). Real values live only there — never commit them.
# A second stage of this app on the same host (e.g. sit next to prod): its own directory, and here a different
# COMPOSE_PROJECT_NAME plus different host ports. Leave it unset for the only / the production stage.
#COMPOSE_PROJECT_NAME={{kit.name}}-sit
# Running tags — the deploy script rewrites these lines.
API_TAG=latest
UI_TAG=latest
# Host ports — must be registered and free.
API_PORT={{kit.apiPort}}
UI_PORT={{kit.uiPort}}
# App secrets below.

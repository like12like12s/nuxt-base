{
  "name": "api",
  "status": "ready",
  "description": "API standard: hono + zod-openapi, /api/v1, error shape with traceId, pagination, health live/ready, /version, openapi.json contract test, typed client (fullstack: useApi)",
  "kinds": [
    "api",
    "fullstack"
  ],
  "requires": [
    "db",
    "testkit"
  ],
  "contributes": {
    "api": {
      "package": {
        "scripts": {
          "contract": "tsx src/contract.ts"
        },
        "dependencies": {
          "@hono/zod-openapi": "^1.6.3"
        }
      },
      "env": [
        {
          "key": "APP_COMMIT",
          "required": false,
          "secret": false,
          "example": "",
          "description": "Git commit of the running build, shown by GET /version. In an image: the build arg of the same name, else taken from APP_IMAGE_TAG"
        },
        {
          "key": "APP_BUILT_AT",
          "required": false,
          "secret": false,
          "example": "",
          "description": "Build time (ISO-8601), shown by GET /version. In an image: the build arg of the same name, else the time the image build stamped"
        },
        {
          "key": "APP_IMAGE_TAG",
          "required": false,
          "secret": false,
          "example": "",
          "description": "Tag of the running image (the container compose file passes it); a trailing commit in it is what /version reports when APP_COMMIT is not set"
        }
      ],
      "files": [
        {
          "from": "files",
          "to": ""
        },
        {
          "from": "variants/openapi.json",
          "to": "openapi.json",
          "when": {
            "without": [
              "auth"
            ]
          }
        }
      ],
      "locked": [
        {
          "from": "runtime/api/app.ts",
          "to": "src/kit/api/app.ts"
        },
        {
          "from": "runtime/api/build-info.ts",
          "to": "src/kit/api/build-info.ts"
        },
        {
          "from": "runtime/api/errors.ts",
          "to": "src/kit/api/errors.ts"
        },
        {
          "from": "runtime/api/health.ts",
          "to": "src/kit/api/health.ts"
        },
        {
          "from": "runtime/api/kit-version.ts",
          "to": "src/kit/api/kit-version.ts"
        },
        {
          "from": "runtime/api/pagination.ts",
          "to": "src/kit/api/pagination.ts"
        }
      ],
      "usage": "usage.md"
    },
    "ui": {
      "package": {
        "scripts": {
          "client": "openapi-typescript ../{{kit.apiDir}}/openapi.json -o app/api/schema.d.ts"
        },
        "dependencies": {
          "openapi-fetch": "^0.17.0"
        },
        "devDependencies": {
          "openapi-typescript": "^7.13.0"
        }
      },
      "files": [
        {
          "from": "files-ui",
          "to": ""
        },
        {
          "from": "variants/schema.d.ts",
          "to": "app/api/schema.d.ts",
          "when": {
            "without": [
              "auth"
            ]
          }
        }
      ],
      "usage": "usage-ui.md"
    },
    "project": {
      "files": [
        {
          "from": "../../playbooks/add-resource.md",
          "to": "dot.memory/docs/guides/playbook-add-resource.md"
        }
      ]
    }
  },
  "generators": {
    "resource": {
      "module": "generators/resource.mjs",
      "part": "api"
    }
  }
}

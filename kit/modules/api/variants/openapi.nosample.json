{
  "openapi": "3.1.0",
  "info": {
    "title": "{{kit.name}}",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "ok",
                    "fail"
                  ]
                },
                "ms": {
                  "type": "number"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "status",
                "ms"
              ]
            }
          }
        },
        "required": [
          "status"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION",
                  "UNAUTHORIZED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "CONFLICT",
                  "RATE_LIMITED",
                  "INTERNAL",
                  "COMMIT_OUTCOME_UNKNOWN"
                ],
                "description": "Switch on this, never on the message. COMMIT_OUTCOME_UNKNOWN (503): the write may have been applied — read the current state before sending it again."
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {}
              },
              "traceId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "traceId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Version": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "builtAt": {
            "type": "string"
          },
          "kit": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "commit",
          "builtAt",
          "kit"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness — the process is up (touches nothing else)",
        "responses": {
          "200": {
            "description": "Alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Readiness — every dependency check passes",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Not ready — details = the check list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "What is running",
        "responses": {
          "200": {
            "description": "Build information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
